# ============================================================
# OpenClaw Gateway Runtime Environment
# Copy to: /data/etc/openclaw/runtime.env
# Set permissions: chmod 600 runtime.env
# NEVER commit real values to git.
#
# Each variable is injected into the gateway container.
# Docker Compose reads this file via env_file directive.
#
# Two ways to wire a model provider — pick per provider:
#   1) Built-in providers: just set the well-known env var below.
#      The gateway auto-reads it and builds the provider (no JSON edit needed).
#      Built-in catalog: openai, anthropic, zai, gemini, deepseek, openrouter,
#      xai, mistral, groq, minimax, moonshot, ... (see `openclaw models list`)
#   2) Custom / OpenAI- or Anthropic-compatible endpoint: do NOT use an env var.
#      Instead add a models.providers entry in openclaw.json
#      (baseUrl + apiKey + api type), or run:
#        openclaw onboard --non-interactive \
#          --auth-choice custom-api-key \
#          --custom-base-url "https://llm.example.com/v1" \
#          --custom-model-id "my-model" \
#          --custom-compatibility openai   # or anthropic / Unknown (auto-detect)
#      The quickstart.sh handles both paths interactively.
# After configuring, set the default model:
#   openclaw models set <provider>/<model>     # e.g. openai/gpt-5.5, zai/glm-4.7
# ============================================================================

# --- Image versions (used in docker-compose) ---
OPENCLAW_IMAGE=ghcr.io/openclaw/openclaw:YOUR_OPENCLAW_VERSION_HERE
MIHOMO_IMAGE=metacubex/mihomo:YOUR_MIHOMO_VERSION_HERE

# --- Gateway authentication ---
# Token for CLI/API access. Generate with: openssl rand -hex 32
OPENCLAW_GATEWAY_TOKEN=YOUR_GATEWAY_TOKEN_HERE

# --- Built-in model provider API keys (gateway auto-reads) ---
# Set ONLY the ones you use. Leave empty to skip.
# Each maps to a built-in provider; the matching catalog is published automatically.
OPENAI_API_KEY=YOUR_OPENAI_API_KEY_HERE
ANTHROPIC_API_KEY=YOUR_ANTHROPIC_API_KEY_HERE
ZAI_API_KEY=YOUR_ZAI_API_KEY_HERE
GEMINI_API_KEY=YOUR_GEMINI_API_KEY_HERE
DEEPSEEK_API_KEY=YOUR_DEEPSEEK_API_KEY_HERE
OPENROUTER_API_KEY=YOUR_OPENROUTER_API_KEY_HERE
# XAI_API_KEY=YOUR_XAI_API_KEY_HERE
# MISTRAL_API_KEY=YOUR_MISTRAL_API_KEY_HERE
# GROQ_API_KEY=YOUR_GROQ_API_KEY_HERE
# MINIMAX_API_KEY=YOUR_MINIMAX_API_KEY_HERE
# MOONSHOT_API_KEY=YOUR_MOONSHOT_API_KEY_HERE

# --- Telegram bot ---
# Get from @BotFather
TELEGRAM_BOT_TOKEN=YOUR_TELEGRAM_BOT_TOKEN_HERE
# Your Telegram user ID (from @userinfobot)
TELEGRAM_OWNER_ID=YOUR_TELEGRAM_USER_ID_HERE

# --- Task engine / stale alert notification target ---
# Telegram account/chat ID for task-engine notifications
TE_ALERT_TARGET=YOUR_TELEGRAM_USER_ID_HERE

# --- mihomo external-controller secret ---
MIHOMO_SECRET=YOUR_MIHOMO_SECRET_HERE

# --- GitHub (for updates, not required) ---
GH_TOKEN=YOUR_GITHUB_PAT_HERE

# --- Timezone ---
TZ=Asia/Shanghai

# --- Optional: proxy for model API calls ---
# If your model provider needs a proxy, set these.
# If mihomo TUN handles it, leave empty.
# HTTPS_PROXY=http://127.0.0.1:7890
# HTTP_PROXY=http://127.0.0.1:7890
