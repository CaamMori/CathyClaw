{
  "meta": { "lastTouchedVersion": "YOUR_OPENCLAW_VERSION_HERE" },
  "gateway": {
    "mode": "local",
    "port": 18789,
    "bind": "loopback",
    "auth": { "token": "${OPENCLAW_GATEWAY_TOKEN}" },
    "controlUi": {
      "allowedOrigins": [
        "http://127.0.0.1:18789",
        "http://localhost:18789"
      ]
    }
  },
  "channels": {
    "telegram": {
      "enabled": true,
      "botToken": "${TELEGRAM_BOT_TOKEN}",
      "allowFrom": ["tg:${TELEGRAM_OWNER_ID}"],
      "streaming": {
        "mode": "progress",
        "progress": {
          "toolProgress": true,
          "commandText": "status",
          "commentary": false
        }
      }
    }
  },
  "commands": {
    "ownerAllowFrom": ["telegram:${TELEGRAM_OWNER_ID}"]
  },
  "agents": {
    "defaults": {
      "model": {
        "primary": "${PRIMARY_MODEL}",
        "fallbacks": ["${FALLBACK_MODEL}"]
      },
      "compaction": {
        "mode": "safeguard",
        "timeoutSeconds": 600,
        "keepRecentTokens": 20000,
        "postIndexSync": "async",
        "notifyUser": false
      },
      "thinkingDefault": "off",
      "verboseDefault": "off",
      "timeoutSeconds": 600,
      "sandbox": {
        "browser": {
          "enabled": true,
          "network": "openclaw-sandbox-browser",
          "cdpPort": 9222
        },
        "docker": {
          "binds": [],
          "network": "bridge",
          "dangerouslyAllowExternalBindSources": false,
          "dangerouslyAllowReservedContainerTargets": false,
          "dangerouslyAllowContainerNamespaceJoin": false
        }
      }
    },
    "ownership": "explicit",
    "entries": {
      "main": {
        "name": "Main",
        "workspace": "/home/node/.openclaw/workspace",
        "identity": { "emoji": "🌙" },
        "reasoningDefault": "stream",
        "sandbox": {
          "docker": {
            "binds": [
              "/data/state/workspace/task-engine:/opt/task-engine:rw",
              "/data/state/workspace/memory:/workspace/memory:rw",
              "/data/state/sandbox-tools:/opt/tools:rw"
            ],
            "network": "container:openclaw-gateway",
            "dangerouslyAllowReservedContainerTargets": true,
            "dangerouslyAllowExternalBindSources": true,
            "dangerouslyAllowContainerNamespaceJoin": true,
            "env": {
              "GH_TOKEN": "${GH_TOKEN}",
              "GITHUB_TOKEN": "${GH_TOKEN}",
              "TAVILY_API_KEY": "${TAVILY_API_KEY}"
            }
          }
        },
        "tools": {
          "elevated": {
            "allowFrom": { "telegram": ["tg:${TELEGRAM_OWNER_ID}"] }
          }
        }
      },
      "guest": {
        "name": "Guest",
        "workspace": "~/.openclaw/workspace-guest",
        "sandbox": {
          "browser": {
            "enabled": true,
            "autoStart": true,
            "binds": [],
            "allowHostControl": false
          },
          "docker": {
            "binds": [],
            "network": "container:openclaw-gateway",
            "dangerouslyAllowReservedContainerTargets": false,
            "dangerouslyAllowExternalBindSources": false,
            "dangerouslyAllowContainerNamespaceJoin": true,
            "env": {
              "TAVILY_API_KEY": "${TAVILY_API_KEY}",
              "PYTHONPATH": "/workspace/.sandbox-tools",
              "PATH": "/workspace/.sandbox-tools/bin:/usr/local/bin:/usr/bin:/bin:/usr/local/sbin:/usr/sbin:/sbin"
            }
          }
        },
        "tools": { "deny": ["canvas", "cron", "nodes"] },
        "identity": { "emoji": "🌿" }
      }
    }
  },
  "models": {
    "providers": {}
  }
}
