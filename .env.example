# OpenClaw 环境变量模板
# 复制为 .env 后填写实际值，禁止提交至 git

# ── 可选：域名（有空填，不填走 IP + 8080）──
DOMAIN=

# ── 必填：至少一个模型 API Key ──
# Gateway 内置各 provider 默认端点，只填 key 即可
# 如需自定义 URL（代理/本地 Ollama），在 gateway.json 的 models.providers 里配
ANTHROPIC_API_KEY=

GROK_API_KEY=

# ── 可选：非交互自动配置模型 provider（设为非空则 install.sh 在无 TTY 时也自动写入）──
# 适用于 CI / 一键脚本场景，避免交互式配置被跳过而需手改 openclaw.json。
# 留空 = 保持原交互行为（有 TTY 时提问，无 TTY 时跳过）。
# OPENCLAW_PROVIDER_NAME=my-provider     # provider 名称
# OPENCLAW_PROVIDER_BASE_URL=https://your-host/v1   # 你的中转站/兼容端点
# OPENCLAW_PROVIDER_API=openai-completions   # openai-completions / openai-responses / anthropic-messages / azure-openai-responses
# OPENCLAW_PROVIDER_KEY=sk-xxx
# OPENCLAW_PROVIDER_MODELS=model-a,model-b   # 逗号分隔；留空则尝试自动拉 /models
OPENCLAW_PROVIDER_NAME=
OPENCLAW_PROVIDER_BASE_URL=
OPENCLAW_PROVIDER_API=
OPENCLAW_PROVIDER_KEY=
OPENCLAW_PROVIDER_MODELS=

# ── 可选：覆盖默认值 ──
GATEWAY_IMAGE=ghcr.io/openclaw/openclaw:2026.9.4
MIHOMO_IMAGE=metacubex/mihomo:latest
GATEWAY_PORT=18789
GATEWAY_MEM_LIMIT=
GATEWAY_CPU_LIMIT=
GATEWAY_PID_LIMIT=1024
SSH_PORT=22
BACKUP_RETENTION_DAYS=7
CONN_LIMIT=15
SWAP_SIZE=2G
DOCKER_GROUP_ID=999  # stat -c '%g' /var/run/docker.sock

# ── mihomo TUN 代理 sidecar（仅境内机需要）──
# 默认「不填」= 安装时自动探测：能直连 GitHub 的海外机自动跳过，直连不了的境内机自动启用。
# 如需强制：1=启用（境内机），0=禁用（海外机直连）。
# MIHOMO_ENABLE=
# MIHOMO_SECRET=changeme  # mihomo external-controller 访问密码

# ── 可选：任务引擎（--with-task-engine 或 TASK_ENGINE_ENABLE=1）──
# TASK_ENGINE_ENABLE=1
# TE_ALERT_TARGET=YOUR_TELEGRAM_USER_ID  # 任务引擎告警目标

# ── 可选：Telegram 机器人接入（--with-telegram 或 TELEGRAM_ENABLE=1）──
# 作用：把 OpenClaw 接入一个 Telegram 机器人，让你在 Telegram 里与 agent 对话。
# token 来自 @BotFather（聊天 /newbot 创建）。token 走环境变量 ${TELEGRAM_BOT_TOKEN}
# （写入 runtime.env），不落 openclaw.json 明文。
#
# 用法：sudo ./scripts/install.sh --with-telegram   # 交互台引导输入 token + 账号 ID
# 或 .env 里设 TELEGRAM_ENABLE=1 + 下面两个变量（非交互一键部署）
# TELEGRAM_ENABLE=1                  # 1 = 启用（等价 --with-telegram）
# TELEGRAM_BOT_TOKEN=123:abc...     # BotFather 给的 bot token（仅非交互环境需要预填，交互台会引导输入）
# TELEGRAM_ALLOW_FROM=YOUR_TELEGRAM_USER_ID     # 允许访问的 Telegram 账号 ID（多个逗号分隔）；留空则用 pairing（首次 DM 需 approve）

# ── 沙箱（--with-sandbox）──
# 官方沙箱构建脚本的拉取分支（对应你的 OpenClaw 版本）
OPENCLAW_SRC_REF=main
# 沙箱镜像加速站（留空则不重打 tag）；例: ghcr.nju.edu.cn
SANDBOX_IMAGE_MIRROR=
